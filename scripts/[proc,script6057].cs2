// 6057
[proc,script6057]
def_component $component0 = orbs:health_regen;
if (~on_mobile = 0 & ~toplevel_getcomponents ! enum_1129 & %minimap_toggle = 1) {
	$component0 = orbs_nomap:health_regen;
} else if (~on_mobile = 1 & %osm_minimap_toggle = 1) {
	$component0 = orbs_osm_nomap:health_regen;
}
cc_deleteall($component0);
if_setontimer(null, $component0);
