// 8474
[proc,ui_highlight_init_fx](component $component0, int $comsubid1, dbrow $dbrow2)
switch_dbtable (db_getrowtable($dbrow2)) {
	case ui_highlighting_fx_pulse :
		cc_setontimer("ui_highlight_pulse($component0, $comsubid1, cc_getlayer, cc_getid, db_getfield($dbrow2, ui_highlighting_fx_pulse:transparency_range, 0), db_getfield($dbrow2, ui_highlighting_fx_pulse:step_duration, 0), db_getfield($dbrow2, ui_highlighting_fx_pulse:use_global_time, 0))");
	case ui_highlighting_fx_single_pulse :
		cc_setontimer("script10161($component0, $comsubid1, cc_getlayer, cc_getid, db_getfield($dbrow2, ui_highlighting_fx_single_pulse:transparency_range, 0), db_getfield($dbrow2, ui_highlighting_fx_single_pulse:start_duration, 0), db_getfield($dbrow2, ui_highlighting_fx_single_pulse:end_duration, 0), db_getfield($dbrow2, ui_highlighting_fx_single_pulse:use_global_time, 0))");
}
