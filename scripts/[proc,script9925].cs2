// 9925
[proc,script9925](int $int0, int $int1, int $comsubid2, int $comsubid3, component $component4, graphic $graphic5, graphic $graphic6)
if (cc_find($component4, $comsubid2) = true) {
	if ($int0 = 1) {
		cc_settrans(~script2478(15));
	} else if (calc($int1 % 2) = 0) {
		cc_settrans(~script2478(10));
	} else {
		cc_settrans(~script2478(4));
	}
}
if (cc_find($component4, $comsubid3) = true) {
	if ($int0 = 1) {
		cc_setgraphic($graphic6);
	} else {
		cc_setgraphic($graphic5);
	}
}
