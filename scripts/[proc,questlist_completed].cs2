// 5995
[proc,questlist_completed](component $com_questlist_completed0)
def_string $string0 = ",";
if (~speedrunning_world = 0) {
	if_settext("<int_0=<tostring(%quests_completed_count)>><int_1=<tostring(%quests_total_count)>>Completed: <int_0:spacer>/<int_1:spacer>", $com_questlist_completed0);
} else {
	if_settext("<int_0=<tostring(min(%speedrun_points, 800000))>>Speedrun Points: <int_0:spacer>", $com_questlist_completed0);
}
