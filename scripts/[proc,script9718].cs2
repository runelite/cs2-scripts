// 9718
[proc,script9718](int $int0, int $int1)
def_int $int2 = cc_getheight;
def_component $component3 = cc_getlayer;
def_int $comsubid4 = cc_getid;
def_int $comsubid5 = -1;
if (cc_findnextsibling = ^true) {
	$comsubid5 = cc_getid;
}
if (cc_find($component3, $comsubid4) = true) {
	if ($int2 < $int0) {
		cc_setscrollsize(0, $int0);
		if ($int1 > 0) {
			cc_setscrollpos(0, min($int1, calc($int0 - $int2)));
		}
		~scrollbar_vertical_dynamic_rebuild($component3, $comsubid5, $component3, $comsubid4);
	} else {
		cc_setscrollsize(0, 0);
		cc_setscrollpos(0, 0);
		cc_setsize(0, 0, ^setsize_minus, ^setsize_minus);
		if (cc_find($component3, $comsubid5) = true) {
			cc_sethide(true);
		}
	}
}
cc_find($component3, $comsubid4);
