// 9965
[proc,script9965](component $com_pvptut_scoreboard_ui_tooltip0, string $string0, string $string1)
if (~on_mobile = false) {
	cc_setonmouserepeat("tooltip_mouserepeat(event_com, event_comsubid, $com_pvptut_scoreboard_ui_tooltip0, $string0, 25, 200)");
	cc_setonmouseleave("deltooltip($com_pvptut_scoreboard_ui_tooltip0)");
} else {
	cc_setop(1, $string1);
	cc_setonop("script9966($string0)");
}
