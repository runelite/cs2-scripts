// 1356
[proc,questlist_qp](component $com_questlist_questpoints0)
def_string $string0 = ",";
if (~speedrunning_world = 0) {
	if_settext("<int_0=<tostring(%qp)>><int_1=<tostring(%qp_max)>>Quest Points: <int_0:spacer>/<int_1:spacer>", $com_questlist_questpoints0);
} else {
	if_settext("<int_0=<tostring(~speedrunning_total_trophies)>>Speedrun Trophies: <int_0:spacer>", $com_questlist_questpoints0);
}
