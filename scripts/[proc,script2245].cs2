// 2245
[proc,script2245](dbrow $dbrow0, int $int1, int $int2)(string)
def_int $int3 = 0;
def_int $int4 = 0;
def_int $int5 = 0;
switch_int ($int2) {
	case 11 :
		return(tostring(~script3236($dbrow0)));
	case 9 :
		return(tostring(~bool_to_int(db_getfield($dbrow0, quest:members, 0))));
	case 10 :
		$int3 = db_getfield($dbrow0, quest:type, 0);
		if ($int3 < 0) {
			return("**********");
		}
		return(tostring($int3));
	case 2 :
		$int3 = $int1;
		if ($int3 < 0) {
			return("**********");
		}
		return(tostring($int3));
	case 3 :
		$int3 = db_getfield($dbrow0, quest:difficulty, 0);
		if ($int3 < 0) {
			return("**********");
		}
		return(tostring($int3));
	case 4 :
		$int3 = db_getfield($dbrow0, quest:length, 0);
		if ($int3 < 0) {
			return("**********");
		}
		return(tostring($int3));
	case 5 :
		$int3 = db_getfield($dbrow0, quest:series, 0);
		if ($int3 < 0) {
			return("XXXXXXXXXXXX");
		}
		return(enum(int, string, enum_2097, $int3));
	case 6 :
		$int3 = db_getfield($dbrow0, quest:location, 0);
		if ($int3 < 0) {
			return("**********");
		}
		return(enum(int, string, enum_2096, $int3));
	case 7 :
		return(tostring(calc(10000 + max(db_getfield($dbrow0, quest:requirement_combat, 0), db_getfield($dbrow0, quest:recommended_combat, 0)))));
	case 8 :
		$int3, $int4, $int5 = db_getfield($dbrow0, quest:releasedate, 0);
		$int3, $int4 = calc(10 + $int3), calc(10 + $int4);
		if ($int5 < 2001) {
			return("**********");
		}
		return("<tostring($int5)><tostring($int4)><tostring($int3)>");
	case 1 :
		return(db_getfield($dbrow0, quest:sortname, 0));
	case 12 :
		return("<tostring(calc(10000 + db_getfield($dbrow0, quest:seriesno, 0)))><db_getfield($dbrow0, quest:sortname, 0)>");
	case 17 :
		return(~script10308($dbrow0));
	case 13 :
		return(tostring(calc(10000 + db_getfield($dbrow0, quest:id, 0))));
	case 0 :
		$int3 = db_getfield($dbrow0, quest:ftue_starter, 0);
		if ($int3 < 0 | $int3 >= 3) {
			$int3 = db_getfield($dbrow0, quest:difficulty, 0);
			if ($int3 = 5) {
				$int3 = 3;
			}
			if ($int3 < 0) {
				return("**********");
			}
			return(tostring($int3));
		}
		return("*<tostring($int3)>");
	case 14 :
		if ($int1 = 0) {
			if (db_getfield($dbrow0, quest:id, 0) = %last_quest_id) {
				return("*100001<db_getfield($dbrow0, quest:sortname, 0)>");
			} else if (db_getfield($dbrow0, quest:id, 0) = %last_quest_but_1_id) {
				return("*100002<db_getfield($dbrow0, quest:sortname, 0)>");
			} else if (db_getfield($dbrow0, quest:id, 0) = %last_quest_but_2_id) {
				return("*100003<db_getfield($dbrow0, quest:sortname, 0)>");
			} else if (db_getfield($dbrow0, quest:id, 0) = %last_quest_but_3_id) {
				return("*100004<db_getfield($dbrow0, quest:sortname, 0)>");
			} else if (db_getfield($dbrow0, quest:id, 0) = %last_quest_but_4_id) {
				return("*100005<db_getfield($dbrow0, quest:sortname, 0)>");
			} else if (db_getfield($dbrow0, quest:id, 0) = %last_quest_but_5_id) {
				return("*100006<db_getfield($dbrow0, quest:sortname, 0)>");
			} else if (db_getfield($dbrow0, quest:id, 0) = %last_quest_but_6_id) {
				return("*100007<db_getfield($dbrow0, quest:sortname, 0)>");
			} else if (db_getfield($dbrow0, quest:id, 0) = %last_quest_but_7_id) {
				return("*100008<db_getfield($dbrow0, quest:sortname, 0)>");
			} else if (db_getfield($dbrow0, quest:id, 0) = %last_quest_but_8_id) {
				return("*100009<db_getfield($dbrow0, quest:sortname, 0)>");
			} else if (db_getfield($dbrow0, quest:id, 0) = %last_quest_but_9_id) {
				return("*100010<db_getfield($dbrow0, quest:sortname, 0)>");
			}
		}
		return(db_getfield($dbrow0, quest:sortname, 0));
	case 15 :
		if ($int1 = 0) {
			return("**********");
		}
		return("");
	case 16 :
		if ($int1 = 2) {
			return("µµµµµµµµµµµµ");
		}
		return("");
	case default :
		return("");
}
