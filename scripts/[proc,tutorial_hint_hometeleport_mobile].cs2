// 8557
[proc,tutorial_hint_hometeleport_mobile]
if_settext("", tutorial_overlay:hint_text_1);
if_settext("When you're ready, use your Home Teleport spell.", tutorial_overlay:hint_text_2);
def_string $string0 = "This will take you to the mainland.";
if (~script10311 = 1) {
	$string0 = "This will take you to Death's office.";
}
if_settext($string0, tutorial_overlay:hint_text_3);
if_settext("", tutorial_overlay:hint_text_4);
