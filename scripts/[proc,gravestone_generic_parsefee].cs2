// 3475
[proc,gravestone_generic_parsefee](int $int0)(string)
if ($int0 < 0) {
	return("Loading...");
}
if ($int0 = 0) {
	return("Fee: <col=ffffff>Paid</col>");
}
if ($int0 = 1) {
	return("Fee: <col=ffffff>1 coin</col>");
}
return("<int_0=<tostring($int0)>>Fee: <col=ffffff><int_0:spacer> coins</col>");
