// 2504
[clientscript,xp_drops_tooltip_setup](component $component0, component $component1, component $component2, string $string0, string $string1)
if (~on_mobile = 1) {
	~xp_drops_tooltip_mobile($string0, $string1, $component0, $component1, $component2);
} else {
	~xp_drops_tooltip_desktop($string0, $string1, $component0, $component1);
}
