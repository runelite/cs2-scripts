// 3476
[proc,gravestone_generic_parsecoffer](int $int0)(string)
if ($int0 < 0) {
	return("Loading...");
}
if ($int0 = 0) {
	return("Death's Coffer: <col=ffffff>Empty</col><br>Discard items to reduce a fee.");
}
if ($int0 = 1) {
	return("Death's Coffer: <col=ffffff>1 coin</col><br>Discard items to reduce a fee.");
}
return("<int_0=<tostring($int0)>>Death's Coffer: <col=ffffff><int_0:spacer> coins</col><br>Discard items to reduce a fee.");
