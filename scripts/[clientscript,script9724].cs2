// 9724
[clientscript,script9724](component $component0, int $comsubid1, int $int2, int $int3)
if ($comsubid1 ! -1) {
	if (cc_find($component0, $comsubid1) = true & cc_input_getfocus = true) {
		~keyboard_show($int2, $int3);
		return;
	}
} else if (if_input_getfocus($component0) = true) {
	~keyboard_show($int2, $int3);
	return;
}
~keyboard_hide;
