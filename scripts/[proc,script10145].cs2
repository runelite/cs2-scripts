// 10145
[proc,script10145](string $string0)
if (~on_mobile = true) {
	cc_setop(1, $string0);
	cc_setonop("script10146(event_com, event_comsubid, tfa_stats:tooltip, $string0, 512)");
} else {
	cc_setonmouserepeat("tooltip_mouserepeat(event_com, event_comsubid, tfa_stats:tooltip, $string0, 25, 120)");
	cc_setonmouseleave("deltooltip(tfa_stats:tooltip)");
}
