// 9978
[proc,script9978](component $component0, int $comsubid1, component $component2, int $comsubid3)
if (($comsubid1 < 0 & if_find($component0) = true | cc_find($component0, $comsubid1) = true) & ($comsubid3 < 0 & .if_find($component2) = true | .cc_find($component2, $comsubid3) = true)) {
	.cc_setscrollpos(cc_getscrollx, cc_getscrolly);
}
