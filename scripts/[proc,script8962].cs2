// 8962
[proc,script8962](component $com_dog_selection_item_area0, int $int1, int $int2, int $int3, dbrow $dbrow4)(int)
def_int $int5 = 1225;
if (db_getfield($dbrow4, puppy_colours:large, 0) = true) {
	$int5 = 1250;
}
cc_create($com_dog_selection_item_area0, ^iftype_model, $int1, false);
$int1 = calc($int1 + 1);
cc_setsize(66, 64, ^setsize_abs, ^setsize_abs);
