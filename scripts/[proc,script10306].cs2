// 10306
[proc,script10306](component $com_quest_rating_close0)
cc_deleteall($com_quest_rating_close0);
cc_create($com_quest_rating_close0, ^iftype_graphic, 0, false);
cc_setsize(26, 23, ^setsize_abs, ^setsize_abs);
cc_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_centre);
def_graphic $graphic1 = "close_buttons,6";
cc_setgraphic($graphic1);
if_setonmouseleave("script3440(event_com, cc_getid, $graphic1, null)", $com_quest_rating_close0);
$graphic1 = "close_buttons,7";
if_setonmouseover("script3440(event_com, cc_getid, $graphic1, null)", $com_quest_rating_close0);
if_setop(1, "Close", $com_quest_rating_close0);
if_setonop("closebutton_click_sound", $com_quest_rating_close0);
if (%keybinding_esc_to_close = 1) {
	if_setopkey(1, ^key_escape, 0, $com_quest_rating_close0);
}
