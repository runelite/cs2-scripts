		cc_deleteall($com_pvptut_scoreboard_ui_contents1);
		cc_create($com_pvptut_scoreboard_ui_contents1, ^iftype_rectangle, 0, false);
		cc_setposition(0, 20, ^setpos_abs_left, ^setpos_abs_top);
		cc_setsize(111, 32, ^setsize_abs, ^setsize_abs);
		cc_setfill(false);
		cc_setcolour(^black);
		cc_settrans(255);
