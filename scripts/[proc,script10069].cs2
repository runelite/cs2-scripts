// 10069
[proc,script10069](component $component0, int $int1, string $string0, string $string1, int $int2, int $int3)
if_setontimer(null, $component0);
if ($int1 ! -1 & ~on_mobile = false) {
	if_setonmouserepeat("cc_colour_swapper(event_com, $int1, 0xffb35b)", $component0);
	if_setonmouseleave("cc_colour_swapper(event_com, $int1, 0xff981f)", $component0);
}
if_setop(1, $string0, $component0);
if (string_length($string1) > 0) {
	if_setopbase("<col=ff9040><$string1></col>", $component0);
}
if_setonop("script10070(event_op, $component0, $int1, $string0, $string1, $int2, $int3)", $component0);
