// 4575
[clientscript,settings_side_dropdown_hover](int $int0, component $component1, int $comsubid2, int $comsubid3, int $int4)
if (cc_find($component1, $comsubid2) = true & .cc_find($component1, $comsubid3) = true) {
	if ($int0 = 1) {
		if ($int4 = 0) {
			cc_setcolour(0xffb83f);
		}
		.cc_sethide(false);
		.cc_setposition(cc_getx, calc(cc_gety - 1), ^setpos_abs_left, ^setpos_abs_top);
	} else {
		if ($int4 = 0) {
			cc_setcolour(0xff981f);
		}
		.cc_sethide(true);
	}
}
